# Copy to .env.local (gitignored). Never commit real values.
# --- Zetaris (required for the real demo) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# or username/password instead of API key
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
# Lightning prefix for the TPC-DS sample tables, check with SHOW LIGHTNING DATABASES
WHYLEDGER_TPCDS_PREFIX=TPCDS_DB.
# --- LLM (pick one; all optional, agent runs offline without) ---
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# WHYLEDGER_LLM=nvidia|openrouter|meterless|none
# WHYLEDGER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
