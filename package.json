    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "zetaris:setup": "tsx scripts/zetaris-setup.ts",
    "eval:planted": "tsx scripts/eval-planted.ts",
    "eval:zetaris": "tsx scripts/eval-zetaris.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^6.29.1"
  }
